  "Author": "Marco Ieni",
  "Category": "ChatGato",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.js",
  "Description": "A Stream Deck plugin for Codex controls and live Codex / T3 Code thread status. Choose an app on each Agent Status key and track up to 20 recent threads per source, locally or over SSH. Press a Codex key to open its chat, or a T3 Code key to open the T3 Code desktop app. T3 Code does not yet support external navigation to a specific thread. Codex controls include usage limits, approvals, voice input, Fast and Plan modes, reasoning level, navigation, Submit, Fork, and Review. No API key is required. Requires Stream Deck 7.1 or later and macOS 13+ or Windows 10+. Remote T3 reads require SSH and Node.js 22.13+ on the host. For remote Codex chat navigation and the Fork, Fast, and Plan buttons, configure keyboard shortcuts in ChatGPT as described in the property inspector. On macOS, grant Elgato Accessibility permission if prompted for keyboard-driven Codex actions.",
  "Icon": "imgs/plugin",
  "Name": "ChatGato",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "SupportURL": "https://github.com/marcoieni/chatgato/issues",
